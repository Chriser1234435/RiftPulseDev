<bg>
  <vertical child-expand-height="false" spacing="3" pad-left="7" pad-right="7" pad-top="5" pad-bottom="5">
    <horizontal bg="round-rect-panel" child-expand-height="false" spacing="3" pad-left="6" pad-right="6" pad-top="4" pad-bottom="4">
      <vertical child-expand-height="false" spacing="0">
        <text text="RIFTPULSE" font-size="5.5" align="Left"/>
        <text text="DISPLAY LAB  /  LIVE CHAT" font-size="2.8" align="Left"/>
      </vertical>
      <text text="SPATIAL CONTROLS" font-size="3.2" align="Right"/>
    </horizontal>
    <text text="Tune the floating panel in your play space. Changes save automatically." font-size="2.8" align="Center"/>
    <vertical bg="round-rect-panel" child-expand-height="false" spacing="3" pad-left="6" pad-right="6" pad-top="4" pad-bottom="4">
      <text text="POSITION" font-size="3.5" align="Left"/>
      <slider-setting text="LEFT / RIGHT  •  X" value="panel-x" bind-value="true" min="-2.5" max="2.5" increment="0.05" show-buttons="true" apply-on-change="true"/>
      <slider-setting text="UP / DOWN  •  Y" value="panel-y" bind-value="true" min="-2" max="2" increment="0.05" show-buttons="true" apply-on-change="true"/>
      <slider-setting text="VIEWING DISTANCE  •  Z" value="panel-z" bind-value="true" min="0.8" max="4.5" increment="0.05" show-buttons="true" apply-on-change="true"/>
    </vertical>
    <vertical bg="round-rect-panel" child-expand-height="false" spacing="3" pad-left="6" pad-right="6" pad-top="4" pad-bottom="4">
      <text text="SURFACE SIZE" font-size="3.5" align="Left"/>
      <slider-setting text="WIDTH" value="panel-width" bind-value="true" min="60" max="180" increment="2" show-buttons="true" apply-on-change="true"/>
      <slider-setting text="HEIGHT" value="panel-height" bind-value="true" min="40" max="120" increment="2" show-buttons="true" apply-on-change="true"/>
    </vertical>
    <text text="X and Y follow your headset orientation. Z sets distance from your view." font-size="2.7" align="Center"/>
  </vertical>
</bg>
