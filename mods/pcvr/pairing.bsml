<bg>
  <vertical child-expand-height="false" spacing="5" pad-left="8" pad-right="8" pad-top="6" pad-bottom="6">
    <text text="RIFTPULSE" font-size="8" align="Center"/>
    <text text="STREAM CONTROL CENTER  •  BEAT SABER" font-size="3.4" align="Center"/>
    <text text="Connect your stream, manage modules, and position your live chat." font-size="2.8" align="Center"/>
    <vertical bg="round-rect-panel" child-expand-height="false" spacing="4" pad-left="6" pad-right="6" pad-top="5" pad-bottom="5">
      <text text="DEVICE CONNECTION" font-size="4.2" align="Center"/>
      <text text="PAIRING CODE" font-size="3.2" align="Center"/>
      <text id="pairingCodeText" text="-----" font-size="7" align="Center"/>
      <text id="statusText" text="Connect your Beat Saber installation to your RiftPulse account." font-size="2.8" align="Center"/>
      <button id="connectButton" text="GENERATE PAIRING CODE" on-click="connect-click"/>
      <text text="Enter the five-digit code at app.riftpulse.me to link this installation." font-size="2.6" align="Center"/>
      <text id="modulePreviewStatus" text="Module settings sync after pairing." font-size="2.7" align="Center"/>
    </vertical>
    <text text="STREAM MODULES" font-size="4.5" align="Center"/>
    <horizontal bg="round-rect-panel" pad-left="6" pad-right="6" pad-top="5" pad-bottom="5">
      <vertical child-expand-height="false" spacing="4">
        <text text="LIVE CHAT" font-size="4" align="Center"/>
        <text text="Combined chat and supported live events from connected platforms." font-size="2.8" align="Center"/>
        <button id="customizeChatPanelButton" text="CONFIGURE CHAT PANEL" on-click="open-chat-settings"/>
        <button id="chatToggleButton" text="CHAT MODULE: OFF" on-click="toggle-chat"/>
        <button text="BRING CHAT PANEL INTO VIEW" on-click="move-chat-panel"/>
      </vertical>
    </horizontal>
    <horizontal bg="round-rect-panel" pad-left="6" pad-right="6" pad-top="5" pad-bottom="5">
      <vertical child-expand-height="false" spacing="4">
        <text text="BEAT SABER SONG REQUEST" font-size="3.8" align="Center"/>
        <text text="Let viewers request songs through supported live chats." font-size="2.8" align="Center"/>
        <button id="bsrToggleButton" text="BSR MODULE: OFF" on-click="toggle-bsr"/>
      </vertical>
    </horizontal>
  </vertical>
</bg>
