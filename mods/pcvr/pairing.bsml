<bg>
  <vertical child-expand-height="false" spacing="3" pad-left="7" pad-right="7" pad-top="5" pad-bottom="5">
    <horizontal bg="round-rect-panel" child-expand-height="false" spacing="4" pad-left="7" pad-right="7" pad-top="4" pad-bottom="4">
      <vertical child-expand-height="false" spacing="0">
        <text text="RIFTPULSE" font-size="7.2" align="Left"/>
        <text text="NEXUS  /  STREAM COMMAND" font-size="2.8" align="Left"/>
      </vertical>
      <vertical child-expand-height="false" spacing="1">
        <text text="BEAT SABER  •  LIVE CONTROL" font-size="3.2" align="Right"/>
        <text text="YOUR STREAM. ONE CONTROL SURFACE." font-size="2.7" align="Right"/>
      </vertical>
    </horizontal>
    <horizontal child-expand-height="false" spacing="4">
      <vertical child-expand-height="false" spacing="3">
        <vertical bg="round-rect-panel" child-expand-height="false" spacing="3" pad-left="6" pad-right="6" pad-top="4" pad-bottom="4">
          <text text="01  /  DEVICE LINK" font-size="4.1" align="Left"/>
          <text text="PAIRING CODE" font-size="2.8" align="Center"/>
          <text id="pairingCodeText" text="-----" font-size="8" align="Center"/>
          <text id="statusText" text="Generate a code to connect this installation to your RiftPulse account." font-size="2.2" align="Center"/>
          <button id="connectButton" text="GENERATE SECURE CODE" on-click="connect-click"/>
          <text text="Enter the five-digit code at app.riftpulse.me." font-size="2.5" align="Center"/>
        </vertical>
        <vertical bg="round-rect-panel" child-expand-height="false" spacing="2" pad-left="5" pad-right="5" pad-top="4" pad-bottom="4">
          <text text="04  /  SPATIAL DISPLAY" font-size="3.8" align="Left"/>
          <text text="Position, size, and re-center your floating chat surface." font-size="2.6" align="Left"/>
          <button id="customizeChatPanelButton" text="OPEN DISPLAY LAB" on-click="open-chat-settings"/>
          <button text="RE-CENTER CHAT PANEL" on-click="move-chat-panel"/>
        </vertical>
      </vertical>
      <vertical child-expand-height="false" spacing="3">
        <vertical bg="round-rect-panel" child-expand-height="false" spacing="2" pad-left="5" pad-right="5" pad-top="4" pad-bottom="4">
          <text text="02  /  LIVE CHAT" font-size="3.8" align="Left"/>
          <text text="Combined platform chat and supported stream events." font-size="2.6" align="Left"/>
          <button id="chatToggleButton" text="CHAT MODULE: OFF" on-click="toggle-chat"/>
        </vertical>
        <vertical bg="round-rect-panel" child-expand-height="false" spacing="2" pad-left="5" pad-right="5" pad-top="4" pad-bottom="4">
          <text text="03  /  SONG REQUESTS" font-size="3.8" align="Left"/>
          <text text="Let viewers request songs through connected chats." font-size="2.6" align="Left"/>
          <button id="bsrToggleButton" text="SONG REQUESTS: OFF" on-click="toggle-bsr"/>
          <text id="bsrQueueText" text="Loading your song request queue..." font-size="2.3" align="Center"/>
          <button text="REFRESH QUEUE" on-click="refresh-bsr-queue"/>
          <button text="CONFIGURE SONG REQUESTS" on-click="open-bsr-settings"/>
          <button text="OPEN REQUEST QUEUE" on-click="open-bsr-panel"/>
          <button text="RE-CENTER REQUEST PANEL" on-click="recenter-bsr-panel"/>
        </vertical>
      </vertical>
    </horizontal>
  </vertical>
</bg>
