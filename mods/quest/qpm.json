{
    "$schema":  "https://raw.githubusercontent.com/QuestPackageManager/QPM.Package/refs/heads/main/qpm.schema.json",
    "version":  "0.1.5",
    "sharedDir":  "shared",
    "dependenciesDir":  "extern",
    "info":  { "name":  "RiftPulse", "id":  "riftpulse", "version":  "0.1.20",
                 "url":  "https://app.riftpulse.me",
                 "additionalData":  {
                                        "overrideSoName":  "libriftpulse.so",
                                        "cmake":  true
                                    }
             },
    "workspace":  {
                      "scripts":  {
                                      "build":  [
                                                    "pwsh ./scripts/build.ps1"
                                                ],
                                      "clean":  [
                                                    "pwsh ./scripts/build.ps1 -clean"
                                                ],
                                      "copy":  [
                                                   "pwsh ./scripts/copy.ps1 $0:?"
                                               ],
                                      "logcat":  [
                                                     "pwsh ./scripts/start-logging.ps1"
                                                 ],
                                      "qmod":  [
                                                   "pwsh ./scripts/build.ps1",
                                                   "pwsh ./scripts/createqmod.ps1"
                                               ]
                                  },
                      "qmodIncludeDirs":  [
                                              "./build",
                                              "./extern/libs"
                                          ],
                      "qmodIncludeFiles":  [

                                           ],
                      "qmodOutput":  "./RiftPulse.qmod"
                  },
    "dependencies":  [
                         {
                             "id":  "beatsaber-hook",
                             "versionRange":  "^6.4.0",
                             "additionalData":  {

                                                }
                         },
                         {
                             "id":  "scotland2",
                             "versionRange":  "^0.1.6",
                             "additionalData":  {
                                                    "includeQmod":  false
                                                }
                         },
                         {
                             "id":  "bs-cordl",
                             "versionRange":  "^4008.0.0",
                             "additionalData":  {

                                                }
                         },
                         {
                             "id":  "bsml",
                             "versionRange":  "^0.4.51",
                             "additionalData":  {

                                                }
                         },
                         {
                             "id":  "custom-types",
                             "versionRange":  "^0.18.2",
                             "additionalData":  {

                                                }
                         },
                         {
                             "id":  "paper2_scotland2",
                             "versionRange":  "^4.6.1",
                             "additionalData":  {

                                                }
                         }
                     ]
}