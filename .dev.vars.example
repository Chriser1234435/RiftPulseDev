# Copy to .dev.vars for local development only. Never commit .dev.vars.
# Generate two independent random secrets, each at least 32 characters.
PAIRING_HMAC_KEY=<generate-a-unique-random-secret>
BETTER_AUTH_SECRET=<generate-a-different-random-secret>
APP_BASE_URL=http://127.0.0.1:5173
TRUSTED_ORIGINS=http://127.0.0.1:5173
